{
  "name": "TikTok-Content-System – Modus B (Freigabe)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "15 18 * * 1,3,5"
            }
          ]
        }
      },
      "name": "Zeitplan (Mo/Mi/Fr 18:15)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "command": "cd {{ $env.TIKTOK_DIR }} && node src/cli.js produce --next --mode B 2>/dev/null; true"
      },
      "name": "Video produzieren",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const lines = ($json.stdout || '').trim().split('\\n');\nconst r = JSON.parse(lines[lines.length - 1] || '{}');\nreturn [{ json: r }];"
      },
      "name": "Ergebnis lesen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "QA bestanden?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.NOTIFY_FROM }}",
        "toEmail": "={{ $env.NOTIFY_TO }}",
        "subject": "=Freigabe: TikTok-Video {{ $json.id }}",
        "emailFormat": "text",
        "text": "=Neues Video ist fertig und hat die QA bestanden.\n\nVideo: {{ $json.video }}\nDauer: {{ $json.duration }} s\nWarnungen: {{ ($json.warnings || []).join(' | ') || 'keine' }}\n\nFreigeben: {{ $execution.resumeUrl }}?decision=approve\nAblehnen: {{ $execution.resumeUrl }}?decision=reject\n\nOhne Antwort innerhalb von 48 Stunden wird nichts veröffentlicht."
      },
      "name": "Freigabe anfordern",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        880,
        -100
      ]
    },
    {
      "parameters": {
        "resume": "webhook",
        "options": {},
        "limitWaitTime": true,
        "limitType": "afterTimeInterval",
        "resumeAmount": 48,
        "resumeUnit": "hours"
      },
      "name": "Auf Freigabe warten",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1100,
        -100
      ],
      "webhookId": "tiktok-freigabe"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.query && $json.query.decision }}",
              "rightValue": "approve",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Freigegeben?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1320,
        -100
      ]
    },
    {
      "parameters": {
        "command": "=cd {{ $env.TIKTOK_DIR }} && node src/cli.js approve {{ $('Ergebnis lesen').item.json.id }} --by n8n-mail"
      },
      "name": "Freigabe vermerken",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1540,
        -200
      ]
    },
    {
      "parameters": {
        "command": "=cd {{ $env.TIKTOK_DIR }} && {{ $env.MEDIA_UPLOAD_CMD }} output/{{ $('Ergebnis lesen').item.json.id }}/video.mp4"
      },
      "name": "Video-URL bereitstellen",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1760,
        -200
      ]
    },
    {
      "parameters": {
        "command": "=cd {{ $env.TIKTOK_DIR }} && node src/cli.js publish {{ $('Ergebnis lesen').item.json.id }} --mode B --video-url {{ $json.stdout.trim() }}"
      },
      "name": "An Buffer übergeben",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1980,
        -200
      ]
    },
    {
      "parameters": {
        "amount": 30,
        "unit": "minutes"
      },
      "name": "30 Minuten warten",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        2200,
        -200
      ],
      "webhookId": "tiktok-statuswarten"
    },
    {
      "parameters": {
        "command": "=cd {{ $env.TIKTOK_DIR }} && node src/cli.js status {{ $('Ergebnis lesen').item.json.id }}"
      },
      "name": "Status prüfen",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        2420,
        -200
      ]
    },
    {
      "parameters": {
        "command": "=cd {{ $env.TIKTOK_DIR }} && node src/cli.js reject {{ $('Ergebnis lesen').item.json.id }} --why abgelehnt-per-mail"
      },
      "name": "Ablehnung vermerken",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1540,
        0
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.NOTIFY_FROM }}",
        "toEmail": "={{ $env.NOTIFY_TO }}",
        "subject": "TikTok-System: QA nicht bestanden oder nichts zu tun",
        "emailFormat": "text",
        "text": "={{ JSON.stringify($json, null, 2) }}"
      },
      "name": "Problem melden",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        880,
        120
      ]
    }
  ],
