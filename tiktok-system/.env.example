# Kopiere nach .env (nie committen). Ohne Schlüssel läuft nur Modus A mit Test-Stimme (espeak-ng).
# ElevenLabs – deutsche Voiceovers (https://elevenlabs.io, Profil → API Keys)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Buffer – Veröffentlichung (https://developers.buffer.com, Access Token)
BUFFER_ACCESS_TOKEN=
BUFFER_TIKTOK_CHANNEL_ID=
# Optional: Anthropic API für automatische Content-Pakete (sonst Claude Code / Abo)
ANTHROPIC_API_KEY=
# Optional: Pfad zu Chrome Headless Shell für Remotion (sonst Remotion-Download)
REMOTION_BROWSER=
# Modus C: zusätzlich zur Konfiguration muss dieser Wert exakt gesetzt sein
AUTOPUBLISH_CONFIRM=
